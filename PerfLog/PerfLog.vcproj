<?xml version="1.0" encoding="windows-1250"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.10"
	Name="PerfLog"
	SccProjectName="&quot;$/&quot;, AAAAAAAA"
	SccAuxPath=""
	SccLocalPath="..\.."
