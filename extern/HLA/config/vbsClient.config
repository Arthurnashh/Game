# Fort Polk VBS2
# UTM is 461963.913 3416866.220 (Zone 15)
#OriginLatitude=30*53'04.09"
#OriginLongitude=-93*23'52.60"
OriginNorthing=3416866.220
OriginEasting=461963.913
OriginZone=15
OriginHemisphere=N

# Adjust this value to raise or lower the VBS 2 map
# by a consistent amount
AltitudeOffset=-72

# Enabling this option allows generic matching
# of a DIS enumeration to a VBS 2 entity model
# Disabling means the entity will only be created
# in VBS 2 if an exact match is found in either
# disEntity.config or disMunition.config
DISEntityMatching=1

# Enable this option to both send and receive articulation
# information on vehicles with turrets
ArticulationSupport=1
ArticulationInvert=1

# This option clamps entities to the terrain in VBS 2 regardless
# of their reported altitude.
# Note: this does not affect FWA or RWA when their engines are
# on.
GroundClamping=1

# This option is currently redundant for VBS 2 and
# will be removed or modified in future releases
ApplyDamage=1

# Logging options...
# Usually disabled unless you are looking for to determine
# a new VBS 2 model name of either an entity or munition type.
LogEntityTypes=0
LogMunitionTypes=0

# This mode disables all outgoing traffic from VBS 2
# VBS 2 will receive and render remote entities but 
# will not publish its local entities.
StealthMode=0

# Message options
# for normal operation these should all be enabled (1)
EntityCreationToVBS=1
EntityCreationFromVBS=1
EntityUpdateToVBS=1
EntityUpdateFromVBS=1
WeaponFireToVBS=1
WeaponFireFromVBS=1
MunitionDetonationToVBS=1
MunitionDetonationFromVBS=1

# Enable geographic regional filtering - enabled(1), disabled(0)
Filter=0

# North most extent for regional filtering, anything north of this
# value will be filtered. North is +ve, South is -ve.
# Format is metres relative to the origin.
FilterNorth=1000

# South most extent for regional filtering, anything south is filtered.
FilterSouth=-1000

# West most extent for regional filtering, anything west is filtered.
# West is -ve, East is +ve.
FilterWest=-1000

# East most extent for regional filtering, anything east is filtered.
FilterEast=1000

# The IP Address of the CNRLog Server
CNRLogAddress=10.0.1.125

# The Port to connect to the CNRLog Server
CNRLogPort=8080

