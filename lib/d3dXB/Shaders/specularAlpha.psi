// specular with alpha, no detail texture

tex t0
texcoord t2 // env. reflection half-vector
texcoord t3 // normal

mul r0, v0, t0 // apply diffuse

dp3_x2 r1, v1,v1 // calculate specular intensity

mad r0.a, r0, c[T0_MAXCOLOR], r1

dp3 r1, t2_bx2, t3_bx2

// cos 2x = 2 cos^2(x) - 1
mad_x4 r1, r1_sat, r1_sat, zero_bias // zero_bias = -0.5

// multiply cos by 2 to get sharp edge
lrp r1, r1_sat.a, c[PS_SKY_REFL_COLOR], c[PS_GROUND_REFL_COLOR]

// blend between color of the env. reflection and color of the object
lrp r0.rgb, r1.a, r1.rgb, r0.rgb

add r0.rgb, r0, v1 // add specular

