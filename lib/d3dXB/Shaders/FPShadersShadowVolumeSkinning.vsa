#include "d3dXB/shaders/FPShadersDecl.h"

xvs.1.1

// Tell the compiler to link the module as a fragment (without validation on registers to be initialized and without optimalizations)
//#pragma fragment

// Tell the compiler to not to add the screenspace conversion instructions
#pragma screenspace


// Skinning transformations

#define SKINNED_VERTEXA r4
#define SKINNED_VERTEXB r5

// ------------
// Basic vertex

// Process indices
mad r0, INPUT_BLENDINDICES, c[MATRICES_OFFSET_765].yyyy, c[MATRICES_OFFSET_765].xxxx
dp4 r1.x, c[CONSTANTS_0_1_765_0d5].yyyy, INPUT_BLENDWEIGHT
sub r1.x, c[CONSTANTS_0_1_765_0d5].y, r1.x
mov r1.y, c[CONSTANTS_0_1_765_0d5].x

// Decompress
mul r3, INPUT_POSITION, c[POS_MUL]
add r3, r3, c[POS_ADD]

// Skinning of position
mov a0.x, r0.x
m4x3 r2.xyz, r3, c[BONES_START + a0.x]
mul SKINNED_POSITION.xyz, r2.xyz, INPUT_BLENDWEIGHT.x
mov a0.x, r0.y
m4x3 r2.xyz, r3, c[BONES_START + a0.x]
mad SKINNED_POSITION.xyz, r2.xyz, INPUT_BLENDWEIGHT.y, SKINNED_POSITION.xyz
mov a0.x, r0.z
m4x3 r2.xyz, r3, c[BONES_START + a0.x]
mad SKINNED_POSITION.xyz, r2.xyz, INPUT_BLENDWEIGHT.z, SKINNED_POSITION.xyz
mov a0.x, r0.w
m4x3 r2.xyz, r3, c[BONES_START + a0.x]
mad SKINNED_POSITION.xyz, r2.xyz, INPUT_BLENDWEIGHT.w, SKINNED_POSITION.xyz

// Identity skinning
mad SKINNED_POSITION.xyz, r3.xyz, r1.xxxy, SKINNED_POSITION.xyz

// ------------
// Vertex A

// Process indices
mad r0, INPUT_BLENDINDICESA, c[MATRICES_OFFSET_765].yyyy, c[MATRICES_OFFSET_765].xxxx
dp4 r1.x, c[CONSTANTS_0_1_765_0d5].yyyy, INPUT_BLENDWEIGHTA
sub r1.x, c[CONSTANTS_0_1_765_0d5].y, r1.x
mov r1.y, c[CONSTANTS_0_1_765_0d5].x

// Decompress
mul r3, INPUT_POSITIONA, c[POS_MUL]
add r3, r3, c[POS_ADD]

// Skinning of position
mov a0.x, r0.x
m4x3 r2.xyz, r3, c[BONES_START + a0.x]
mul SKINNED_VERTEXA.xyz, r2.xyz, INPUT_BLENDWEIGHTA.x
mov a0.x, r0.y
m4x3 r2.xyz, r3, c[BONES_START + a0.x]
mad SKINNED_VERTEXA.xyz, r2.xyz, INPUT_BLENDWEIGHTA.y, SKINNED_VERTEXA.xyz
mov a0.x, r0.z
m4x3 r2.xyz, r3, c[BONES_START + a0.x]
mad SKINNED_VERTEXA.xyz, r2.xyz, INPUT_BLENDWEIGHTA.z, SKINNED_VERTEXA.xyz
mov a0.x, r0.w
m4x3 r2.xyz, r3, c[BONES_START + a0.x]
mad SKINNED_VERTEXA.xyz, r2.xyz, INPUT_BLENDWEIGHTA.w, SKINNED_VERTEXA.xyz

// Identity skinning
mad SKINNED_VERTEXA.xyz, r3.xyz, r1.xxxy, SKINNED_VERTEXA.xyz

// ------------
// Vertex B

// Process indices
mad r0, INPUT_BLENDINDICESB, c[MATRICES_OFFSET_765].yyyy, c[MATRICES_OFFSET_765].xxxx
dp4 r1.x, c[CONSTANTS_0_1_765_0d5].yyyy, INPUT_BLENDWEIGHTB
sub r1.x, c[CONSTANTS_0_1_765_0d5].y, r1.x
mov r1.y, c[CONSTANTS_0_1_765_0d5].x

// Decompress
mul r3, INPUT_POSITIONB, c[POS_MUL]
add r3, r3, c[POS_ADD]

// Skinning of position
mov a0.x, r0.x
m4x3 r2.xyz, r3, c[BONES_START + a0.x]
mul SKINNED_VERTEXB.xyz, r2.xyz, INPUT_BLENDWEIGHTB.x
mov a0.x, r0.y
m4x3 r2.xyz, r3, c[BONES_START + a0.x]
mad SKINNED_VERTEXB.xyz, r2.xyz, INPUT_BLENDWEIGHTB.y, SKINNED_VERTEXB.xyz
mov a0.x, r0.z
m4x3 r2.xyz, r3, c[BONES_START + a0.x]
mad SKINNED_VERTEXB.xyz, r2.xyz, INPUT_BLENDWEIGHTB.z, SKINNED_VERTEXB.xyz
mov a0.x, r0.w
m4x3 r2.xyz, r3, c[BONES_START + a0.x]
mad SKINNED_VERTEXB.xyz, r2.xyz, INPUT_BLENDWEIGHTB.w, SKINNED_VERTEXB.xyz

// Identity skinning
mad SKINNED_VERTEXB.xyz, r3, r1.xxxy, SKINNED_VERTEXB.xyz

// -------------------------------------------------------------------------
// Calculate normal from SKINNED_VERTEX, SKINNED_VERTEXA and SKINNED_VERTEXB

#define VECTOR_A r10
#define VECTOR_B r11

// Get the 2 vectors
sub VECTOR_A.xyz, SKINNED_VERTEXA.xyz, SKINNED_POSITION.xyz
sub VECTOR_B.xyz, SKINNED_VERTEXB.xyz, SKINNED_POSITION.xyz

// Do the cross product into r1

mul r0.xyz, VECTOR_A.zxy, VECTOR_B.yzx
mad r1.xyz, VECTOR_A.yzx, VECTOR_B.zxy, -r0.xyz

// no need to normalize - we are interested only in dot product sign
// ------------------------------

// Shadow volume protraction
dp3 r0, r1, c[SHADOWDIRECTION_TRANSFORMED_DIR]
sge r0.x, r0.x, c[CONSTANTS_0_1_765_0d5].x

// SKINNED_POSITION = SHADOWDIRECTION_TRANSFORMED_DIR * (r0.x * 20 + 0.05) + SKINNED_POSITION
//mad r0.x, r0.x, c[FOGEND__RCP_FOGEND_MINUS_FOGSTART__SHADOWVOLUME_OFFSET__SHADOWVOLUME_SIZE].w, c[FOGEND__RCP_FOGEND_MINUS_FOGSTART__SHADOWVOLUME_OFFSET__SHADOWVOLUME_SIZE].z
mad r0.x, r0.x, c[SHADOW_OFFSET__SHADOW_SIZE].y, c[SHADOW_OFFSET__SHADOW_SIZE].x
mad SKINNED_POSITION.xyz, c[SHADOWDIRECTION_TRANSFORMED_DIR].xyz, r0.x, SKINNED_POSITION.xyz
mov SKINNED_POSITION.w, c[CONSTANTS_0_1_765_0d5].y

// Transform position
m4x3 TRANSFORMED_POSITION.xyz, SKINNED_POSITION, c[WORLD_VIEW_MATRIX_0]
mov TRANSFORMED_POSITION.w, c[CONSTANTS_0_1_765_0d5].y

// Project position
m4x4 r0, TRANSFORMED_POSITION, c[PROJ_MATRIX_0]

// Convert to screenspace
mul r0.xyz, r0, c[SCREENSPACE_SCALE]
+ rcc r1.x, r0.w
//mad oPos.xyz, r0, r1.x, c[SCREENSPACE_OFFSET]
//mov oPos.w, r0.w
mad r0.xyz, r0, r1.x, c[SCREENSPACE_OFFSET]
// apply 4X AA factors and set .w
mad oPos, r0, c[CONSTANTS_0_1_765_0d5].wwyy, -c[CONSTANTS_0_1_765_0d5].wwxx
