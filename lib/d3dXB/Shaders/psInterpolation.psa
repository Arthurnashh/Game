#include "psDecl.h"

xps.1.1

// detail texturing applied

tex t0
tex t1
texcoord t2

// renormalize normal (NR approximation)
dp3 r1, t2_bx2, t2_bx2  // r0 = N . N
mad r1, t2_bias, 1-r1, t2_bx2 // N * 2 * (1 - N.N)) + N

dp3 r0, r1, c[PS_DIFFUSE_BACK]_bx2 ; r0.a set

lrp r0.rgb, v0.a, t0, t1
+mul r0.a, r0_sat, r0_sat // ^2

mul t0.rgb, r0, c[PS_DIFFUSE]
+mul r1.a, r0, r0 // ^4

mul t1.rgb, r0, c[PS_SPECULAR]
+mul r0.a, r0, r1 // ^6

//lrp r1.rgb, r0.a, c[PS_DIFFUSE], c[PS_SPECULAR]

// r1 = r0.a *  c[PS_DIFFUSE] + (1-r0.a) * c[PS_SPECULAR]

//mul r0.rgb, r1, r0

// final color = s0*s1 + (1-s0)*s2 + s3

// final alpha = s6.b
// special registers:
//   prod = s4*s5.
//   sum  = r0+v1
//   zero = 0
//  s0,       s1,        s2,          s3,           s4,           s5,           s6
xfc r0_sat.a, t0_sat.rgb, t1_sat.rgb, zero_sat.rgb, zero_sat.rgb, zero_sat.rgb, 1-zero.a


