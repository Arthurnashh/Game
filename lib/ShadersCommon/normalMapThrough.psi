; Multiply diffuse coeficient by the dot result and add A*ForcedDiffuse*Emission
mad r0.rgb, r0, c[PS_DIFFUSE], c[PS_ADFORCEDE]
mad r0.rgb, r1, c[PS_DIFFUSE_BACK], r0

; Set the visibility (to t0.a for instance)
+ mov r0.a, v0.a

; Add diffuse lights from v0 accumulator
add r0.rgb, r0, v0

; Multiply it by t0 (combine it with value from color map)
