/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "Open from Source Safe ...",   ID_FILE_OPENFROMSOURCESAFE
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM "Save And Check In...",        ID_FILE_SAVEANDCHECKIN
        MENUITEM SEPARATOR
        POPUP "Source Safe"
        BEGIN
            MENUITEM "Check Out",                   ID_SOURCESAFEOTHERCOMMANDS_CHECKOUT

            MENUITEM "Get Latest Version",          ID_SOURCESAFE_GETLATESTVERSION

            MENUITEM "History",                     ID_SOURCESAFEOTHERCOMMANDS_HISTORY

            MENUITEM "Undo Check Out",              ID_SOURCESAFEOTHERCOMMANDS_UNDOCHECKOUT

            MENUITEM SEPARATOR
            MENUITEM "Disconnect",                  ID_SOURCESAFE_DISCONNECT
        END
        MENUITEM SEPARATOR
        MENUITEM "&Texture Folder...",          ID_FILE_PREF
        MENUITEM "&Merged Folder...",           ID_FILE_MERGED
        MENUITEM "TGA Output",                  ID_FILE_TGAOUTPUT
        MENUITEM SEPARATOR
        MENUITEM "&Export...",                  ID_FILE_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Set"
    BEGIN
        MENUITEM "&Prev\tPgUp",                 ID_SET_PREV
        MENUITEM "&Next\tPgDn",                 ID_SET_NEXT
        MENUITEM SEPARATOR
        MENUITEM "&New",                        ID_SET_ADD
        MENUITEM "&Add...",                     ID_SET_MODEL
        MENUITEM SEPARATOR
        MENUITEM "&Copy\t^C",                   ID_SET_COPY
        MENUITEM "&Merge\t^V",                  ID_SET_MERGE
        MENUITEM "Du&plicate",                  ID_SET_DUPLICATE
        MENUITEM "Apply Damma&ge...",           ID_SET_APPLYDAMMAGE
        MENUITEM "&Delete",                     ID_SET_DELETE
        MENUITEM SEPARATOR
        POPUP "&Size"
        BEGIN
            MENUITEM "Grow &X\tNum 6",              ID_SET_GROW_X
            MENUITEM "Grow &Y\tNum 8",              ID_SET_GROW_Y
            MENUITEM "Sh&rink X\tNum 4",            ID_SET_SHRINK_X
            MENUITEM "Shri&nk Y\tNum 2",            ID_SET_SHRINK_Y
            MENUITEM "",                            1
            MENUITEM "&Shrink All",                 ID_SET_SHRINK_ALL
            MENUITEM "&Grow All",                   ID_SET_GROW_ALL
        END
        MENUITEM SEPARATOR
        MENUITEM "&Auto Arrange\tF7",           ID_SET_ARRANGE
        MENUITEM "&Auto Arrange - Keep Size\tF8", ID_SET_ARRANGE_USE
        MENUITEM "Auto Arrange - Multiple Sets", ID_SET_ARRANGE_MULTI
        MENUITEM "Merge to one",                ID_SET_MERGETOONE
        MENUITEM SEPARATOR
        MENUITEM "Properties\tCtrl+Shift+Enter", ID_SET_PROPERTIES
    END
    POPUP "&Item"
    BEGIN
        MENUITEM "&Prev",                       ID_ITEM_PREV
        MENUITEM "&Next",                       ID_ITEM_NEXT
        MENUITEM SEPARATOR
        MENUITEM "&Add...\tIns",                ID_ITEM_ADD
        MENUITEM "&Delete\tDel",                ID_ITEM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Grow\tUp",                   ID_ITEM_GROW
        MENUITEM "&Shrink\tDown",               ID_ITEM_SHRINK
        MENUITEM "Rotate &Left\tLeft",          ID_ITEM_ROT_LEFT
        MENUITEM "Rotate &Right\tRight",        ID_ITEM_ROT_RIGHT
        MENUITEM SEPARATOR
        MENUITEM "Mark Important",              ID_ITEM_KEEPSIZE
        MENUITEM "Properties\tCtrl+Enter",      ID_ITEM_PROPERTIES
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM "Source Safe Toolbar",         ID_VIEW_SOURCECONTROLTOOLBAR
        MENUITEM "Set Name Bar",                ID_VIEW_SETNAMEBAR
        MENUITEM SEPARATOR
        MENUITEM "Zoom &In\t+",                 ID_VIEW_ZOOM_IN
        MENUITEM "Zoom &Out\t-",                ID_VIEW_ZOOM_OUT
        MENUITEM SEPARATOR
        MENUITEM "Server Console",              ID_VIEW_SERVERCONSOLE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About TexMerge...",          ID_APP_ABOUT
    END
END


